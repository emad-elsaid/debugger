<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  
  <object class="GtkBox" id="sidebar_box">
    <property name="orientation">vertical</property>
    <property name="spacing">12</property>
    <property name="width-request">300</property>
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>
    <property name="margin-top">12</property>
    <property name="margin-bottom">12</property>
    
    <child>
      <object class="AdwPreferencesGroup" id="watches_group">
        <property name="title">Watches</property>
        <child>
          <object class="GtkBox" id="watch_input_box">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkEntry" id="watch_input">
                <property name="placeholder-text">Enter expression to watch</property>
                <property name="hexpand">true</property>
                <property name="activates-default">true</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="watch_add_button">
                <property name="label">Add</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkListBox" id="watches_list">
            <property name="selection-mode">none</property>
            <style>
              <class name="boxed-list"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    
    <child>
      <object class="AdwPreferencesGroup" id="breakpoints_group">
        <property name="title">Breakpoints</property>
        <child>
          <object class="GtkListBox" id="breakpoints_list">
            <property name="selection-mode">none</property>
            <style>
              <class name="boxed-list"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
